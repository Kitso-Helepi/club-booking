# Copy to .env and adjust. Never commit .env.
# All values below are SAFE LOCAL PLACEHOLDERS for the Docker setup in docker-compose.yml.

# --- Database -------------------------------------------------------------
# Runtime app role (data access only). On Neon use the POOLED connection string
# (host contains "-pooler") for this role.
DATABASE_URL=postgres://club_app:app_local_only@localhost:54329/club_booking
# Migration role (owns schema). On Neon use the DIRECT (non-pooled) connection string.
MIGRATION_DATABASE_URL=postgres://club_migrator:migrator_local_only@localhost:54329/club_booking

# Integration tests run against a separate database whose name MUST end in "_test".
TEST_DATABASE_URL=postgres://club_app:app_local_only@localhost:54329/club_booking_test
TEST_MIGRATION_DATABASE_URL=postgres://club_migrator:migrator_local_only@localhost:54329/club_booking_test

# --- App ------------------------------------------------------------------
APP_NAME="Club Booking"
APP_BASE_URL=http://localhost:3000

# --- Staff auth (Better Auth) ---------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-32-random-bytes-base64
BETTER_AUTH_URL=http://localhost:3000

# --- Ticket token encryption ----------------------------------------------
# 32 random bytes, base64. Used to encrypt pass/order tokens so they can be shown again.
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# --- Booking --------------------------------------------------------------
HOLD_MINUTES=10

# --- Payments -------------------------------------------------------------
# PAYMENTS_MODE=test allows the simulator. PAYMENTS_MODE=live REFUSES the simulator.
PAYMENTS_MODE=test
PAYMENT_PROVIDER=simulator
# Used by the simulator to sign its fake webhook events (exercise signature checks).
PAYMENT_SIMULATOR_SECRET=replace-with-random-string

# --- Email ----------------------------------------------------------------
# Local: Mailpit captures everything (UI at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Club Booking <no-reply@club-booking.test>"
# capture = local Mailpit, any recipient allowed.
# allowlist = real SMTP, only EMAIL_ALLOWED_RECIPIENTS receive mail (comma-separated
#             addresses or @domain entries). Everything else is skipped and logged.
EMAIL_DELIVERY_MODE=capture
EMAIL_ALLOWED_RECIPIENTS=

# --- WhatsApp -------------------------------------------------------------
# Guest-initiated share links always work. Automated sending stays OFF unless enabled
# here AND the buyer opts in at checkout. The Meta adapter is a stub.
WHATSAPP_AUTOMATION_ENABLED=false
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# --- Seed -----------------------------------------------------------------
# Password given to the synthetic staff accounts created by `npm run db:seed` (local only).
SEED_STAFF_PASSWORD=replace-with-a-local-dev-password
